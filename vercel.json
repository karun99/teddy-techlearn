{
  "name": "teddy-techlearn",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": { "maxDuration": 30 },
    "api/quiz.js": { "maxDuration": 30 },
    "api/notes.js": { "maxDuration": 30 },
    "api/rag.js": { "maxDuration": 30 },
    "api/learner.js": { "maxDuration": 30 },
    "api/health.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}